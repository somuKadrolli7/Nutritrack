# =============================================
# NutriTrack Server — Environment Variables
# =============================================
# Copy this file to .env and fill in your values

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB Atlas ---
# Get from: https://cloud.mongodb.com
# Format: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/nutritrack
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/nutritrack

# --- JWT Secrets (generate random 64-char strings) ---
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_64_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production_min_64_chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# --- Google Gemini AI ---
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE

# --- Google OAuth (optional - for "Sign in with Google") ---
# Get from: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# --- Cloudinary (optional - for avatar uploads) ---
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Email / Nodemailer (for OTP emails) ---
# Use Gmail with App Password: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=NutriTrack <your_gmail@gmail.com>

# --- Frontend URL (for CORS) ---
CLIENT_URL=http://localhost:3000
